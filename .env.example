# Environment Configuration Template
# Copy this file to .env for local environment overrides
# WARNING: Do NOT commit .env containing actual secrets to source control.

# Server Configuration
PORT=8080
HOST=127.0.0.1

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Dataset File Paths
DATASET_CSV_PATH=data/raw/customer_segmentation_retention_sample.csv
DATASET_EXCEL_PATH=data/raw/customer_segmentation_retention_sample.xlsx

# Security and Credentials Notice:
# This project operates on a synthetic benchmark dataset with zero external API dependencies.
# If integrating with external databases, APIs, or Power BI Service workspaces,
# define credentials in .env (which is strictly ignored by git).
